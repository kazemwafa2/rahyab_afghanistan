<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_gradient">

    <!-- ===== مرحله ۱: خوش‌آمد ===== -->
    <ScrollView
        android:id="@+id/cardIntro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <!-- لوگو و نام (بالا، ابتدای صفحه) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textColor="#2F4858"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="@string/welcome_title"
                android:textAlignment="viewStart"
                android:textColor="#2F4858"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/welcome_subtitle"
                android:textAlignment="viewStart"
                android:textColor="#587083"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/img_welcome_route" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/blue_primary"
                android:text="@string/welcome_what"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#DDEBF5"
                android:text="@string/welcome_go"
                android:textColor="@color/blue_primary"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/welcome_privacy"
                android:textAlignment="center"
                android:textColor="#3D5568"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== مرحله ۲: توضیح مجوز موقعیت ===== -->
    <LinearLayout
        android:id="@+id/cardPerm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F2F2"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/img_perm_curve" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="20dp"
                android:paddingEnd="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_title"
                    android:textAlignment="viewStart"
                    android:textColor="#4D5560"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/perm_body"
                    android:textAlignment="viewStart"
                    android:textColor="#2B3138"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/perm_step1"
                    android:textAlignment="viewStart"
                    android:textColor="#2B3138"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/perm_step2"
                    android:textAlignment="viewStart"
                    android:textColor="#2B3138"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermContinue"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:backgroundTint="@color/blue_primary"
            android:text="@string/perm_continue"
            android:textSize="17sp"
            app:cornerRadius="29dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermLater"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/perm_later"
            android:textColor="#5A6470" />
    </LinearLayout>
</FrameLayout>
